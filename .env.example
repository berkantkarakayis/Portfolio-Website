# ---- Analytics storage (Upstash Redis) -------------------------------------
# Required in production. The Vercel Marketplace integration adds these two
# automatically; copy them here for local development.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# Alternative names if you created the database at console.upstash.com:
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# Not used by this project: KV_REST_API_READ_ONLY_TOKEN, KV_URL, REDIS_URL.
# Force the in-memory store (dev/testing only; data lives in the server process):
# ANALYTICS_STORE=memory

# ---- Hacker Mode (required, add to Vercel: Production + Preview) --------------
# label:secret pairs, comma-separated. Labels [a-z0-9_-]{1,24}; secrets >= 12 chars.
# Remove a pair and redeploy to revoke that person immediately.
HACKER_MODE_SECRETS="owner:CHANGE_ME_min_12_chars,friend1:CHANGE_ME_too"
# openssl rand -hex 32
HACKER_MODE_SIGNING_KEY=""
# openssl rand -hex 16  (rotates the daily IP hash; raw IPs are never stored)
ANALYTICS_IP_SALT=""

# ---- Collector ---------------------------------------------------------------
# On in production builds; set to 1 to also enable it in `next dev`.
NEXT_PUBLIC_ANALYTICS_ENABLED=""
